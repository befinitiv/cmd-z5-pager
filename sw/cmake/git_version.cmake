# Writes the git state of the source tree into a header (run on every build
# by the git_version target in CMakeLists.txt). The header is only rewritten
# when the values change, so unchanged builds stay incremental.
#   cmake -DSRC_DIR=<sw> -DOUT=<header> -P git_version.cmake

execute_process(COMMAND git rev-parse --short HEAD
	WORKING_DIRECTORY ${SRC_DIR} OUTPUT_VARIABLE hash
	OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
# Version of the commit: the latest tag, commits since then and the hash,
# "-dirty" with uncommitted changes (e.g. R0-15-g783be4a-dirty).
execute_process(COMMAND git describe --tags --always --dirty
	WORKING_DIRECTORY ${SRC_DIR} OUTPUT_VARIABLE describe
	OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT hash)
  set(hash "unknown")
endif()
if(NOT describe)
  set(describe "unknown")
endif()
string(FIND "${describe}" "-dirty" dirty_pos)
if(dirty_pos EQUAL -1)
  set(dirty 0)
else()
  set(dirty 1)
endif()

set(content "/* Generated by cmake/git_version.cmake, do not edit. */
#define GIT_HASH \"${hash}\"
#define GIT_DESCRIBE \"${describe}\"
#define GIT_DIRTY ${dirty}
")
if(EXISTS ${OUT})
  file(READ ${OUT} old)
endif()
if(NOT "${old}" STREQUAL "${content}")
  file(WRITE ${OUT} "${content}")
endif()
