CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y
CONFIG_PINCTRL=y

# Link into zephyr,code-partition: slot0_partition for the application,
# boot_partition for MCUboot (its own app.overlay chooses that).
CONFIG_USE_DT_CODE_PARTITION=y

# There is no console UART (the only UART goes to the GPS). By default the
# console goes to SEGGER RTT; the application moves it to USB CDC ACM
# (boards/cmdz5_nrf52840.conf), MCUboot keeps RTT.
CONFIG_CONSOLE=y
CONFIG_USE_SEGGER_RTT=y
CONFIG_RTT_CONSOLE=y
CONFIG_UART_CONSOLE=n
