/*
 * CMD-Z5 replacement board: nRF52840, Wio-SX1262, nPM1300, LIS2DH12,
 * TBS M10N GPS, original Sony CMD-Z5 display, keypad, wheel, speakers.
 * Hardware description: ../../../../board/README.md
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/input/keymap.h>
#include <zephyr/dt-bindings/lora/sx126x.h>
#include <zephyr/dt-bindings/regulator/npm13xx.h>
#include <dt-bindings/cmdz5/keys.h>
#include "cmdz5_nrf52840-pinctrl.dtsi"

/ {
	model = "CMD-Z5 replacement board";
	compatible = "befi,cmdz5";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &code_partition;
	};

	/*
	 * Display bus: D0..D7 on consecutive pins P0.19..P0.26 for single
	 * masked port writes. /CS, CS and pin 9 are tied on the board.
	 */
	lcd_bus: lcd-bus {
		compatible = "cmdz5,lcd-bus-gpio";
		data-gpios = <&gpio0 19 0>, <&gpio0 20 0>, <&gpio0 21 0>, <&gpio0 22 0>,
			     <&gpio0 23 0>, <&gpio0 24 0>, <&gpio0 25 0>, <&gpio0 26 0>;
		wr-gpios = <&gpio1 0 0>;
		a0-gpios = <&gpio0 17 0>;
		reset-gpios = <&gpio1 7 0>;

		lcd: lcd {
			compatible = "sony,cmdz5-lcd";
			power-supply = <&lcd_supply>;
		};
	};

	/* 4 x 5 matrix; columns driven low one at a time, rows read with pull-ups. */
	kbd: kbd-matrix {
		compatible = "gpio-kbd-matrix";
		row-gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			    <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			    <&gpio1 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			    <&gpio1 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>,
			    <&gpio1 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		col-gpios = <&gpio0 31 GPIO_ACTIVE_LOW>,
			    <&gpio0 30 GPIO_ACTIVE_LOW>,
			    <&gpio0 29 GPIO_ACTIVE_LOW>,
			    <&gpio0 28 GPIO_ACTIVE_LOW>;

		keymap {
			compatible = "input-keymap";
			keymap = <MATRIX_KEY(0, 0, INPUT_KEY_1)
				  MATRIX_KEY(0, 1, INPUT_KEY_2)
				  MATRIX_KEY(0, 2, INPUT_KEY_3)
				  MATRIX_KEY(0, 3, CMDZ5_KEY_CALL)
				  MATRIX_KEY(1, 0, INPUT_KEY_4)
				  MATRIX_KEY(1, 1, INPUT_KEY_5)
				  MATRIX_KEY(1, 2, INPUT_KEY_6)
				  MATRIX_KEY(1, 3, CMDZ5_KEY_MEMO)
				  MATRIX_KEY(2, 0, INPUT_KEY_7)
				  MATRIX_KEY(2, 1, INPUT_KEY_8)
				  MATRIX_KEY(2, 2, INPUT_KEY_9)
				  MATRIX_KEY(2, 3, INPUT_KEY_BACKSPACE)
				  MATRIX_KEY(3, 0, CMDZ5_KEY_STAR)
				  MATRIX_KEY(3, 1, INPUT_KEY_0)
				  MATRIX_KEY(3, 2, CMDZ5_KEY_POUND)
				  MATRIX_KEY(4, 0, INPUT_KEY_PAGEDOWN)
				  MATRIX_KEY(4, 1, INPUT_KEY_PAGEUP)
				  MATRIX_KEY(4, 2, INPUT_KEY_ENTER)>;
			row-size = <5>;
			col-size = <4>;
		};
	};

	/* Rotary wheel; the direction may need swapping once tested. */
	wheel: wheel {
		compatible = "gpio-qdec";
		gpios = <&gpio1 12 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>,
			<&gpio1 11 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
		steps-per-period = <4>;
		zephyr,axis = <INPUT_REL_WHEEL>;
		sample-time-us = <2000>;
		idle-timeout-ms = <200>;
	};

	buttons {
		compatible = "gpio-keys";

		/* 4.7-10 MOhm external pull-up: no internal pull-up (it would draw ~230 uA). */
		lid {
			gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
			zephyr,code = <CMDZ5_KEY_LID>;
		};

		/* Shared with nPM1300 SHPHLD through a BAT54C. */
		power {
			gpios = <&gpio1 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_POWER>;
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		/* Board LEDs and keyboard flex LEDs on one low-side switch. */
		backlight: backlight {
			pwms = <&pwm0 0 PWM_USEC(50) PWM_POLARITY_NORMAL>;
		};

		vibration: vibration {
			pwms = <&pwm0 1 PWM_USEC(50) PWM_POLARITY_NORMAL>;
		};
	};

	speaker: speaker {
		compatible = "cmdz5,audio-pwm";
		pwms = <&pwm1 0 PWM_HZ(1000) PWM_POLARITY_NORMAL>;
	};

	earpiece: earpiece {
		compatible = "cmdz5,audio-pwm";
		pwms = <&pwm2 0 PWM_HZ(1000) PWM_POLARITY_NORMAL>;
		amp-supply = <&amp_supply>;
	};
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&uicr {
	/* P0.09/P0.10 drive the SX1262 RF switch and reset. */
	nfct-pins-as-gpios;
	gpio-as-nreset;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	pmic: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;
		host-int-gpios = <&gpio1 5 0>;
		pmic-int-pin = <0>;
		/* Power key on SHPHLD: hold about 1 s to switch on from ship mode. */
		ship-to-active-time-ms = <1008>;

		/* GPIO0 = interrupt to the nRF, GPIO1 = microphone supply. */
		pmic_gpio: gpio-controller {
			compatible = "nordic,npm1300-gpio";
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <5>;
		};

		regulators {
			compatible = "nordic,npm1300-regulator";

			/* Wio-SX1262, off at boot (VSET1 grounded). */
			radio_supply: BUCK1 {
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
			};

			/* Main 3.0 V rail (nRF52840, LIS2DH12), set by VSET2. */
			BUCK2 {
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* LSOUT1: display supply. */
			lcd_supply: LDO1 {
				regulator-initial-mode = <NPM13XX_LDSW_MODE_LDSW>;
			};

			/* LSOUT2: earpiece amplifier supply. */
			amp_supply: LDO2 {
				regulator-initial-mode = <NPM13XX_LDSW_MODE_LDSW>;
			};
		};

		/* The battery has no thermistor contact; NTC is tied to GND. */
		charger: charger {
			compatible = "nordic,npm1300-charger";
			term-microvolt = <4200000>;
			current-microamp = <150000>;
			dischg-limit-microamp = <1000000>;
			vbus-limit-microamp = <500000>;
			thermistor-ohms = <0>;
			thermistor-beta = <3380>;
			charging-enable;
		};
	};

	accel: accel@19 {
		compatible = "st,lis2dh12", "st,lis2dh";
		reg = <0x19>;
		irq-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
	};
};

&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	cs-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";

	/* Powered from BUCK1, which firmware must enable before using the radio. */
	lora0: lora@0 {
		compatible = "semtech,sx1262";
		reg = <0>;
		spi-max-frequency = <8000000>;
		reset-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
		dio1-gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
		rx-enable-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		dio2-tx-enable;
		dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V8>;
		tcxo-power-startup-delay-ms = <5>;
	};
};

/*
 * GPS UART (TBS M10N, powered through the 5 V boost on P1.03). Disabled until
 * the GPS service switches the boost and the pins together; an idle-high TX
 * line would back-power the unpowered module.
 */
&uart0 {
	compatible = "nordic,nrf-uarte";
	status = "disabled";
	current-speed = <38400>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm1 {
	status = "okay";
	pinctrl-0 = <&pwm1_default>;
	pinctrl-1 = <&pwm1_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm2 {
	status = "okay";
	pinctrl-0 = <&pwm2_default>;
	pinctrl-1 = <&pwm2_sleep>;
	pinctrl-names = "default", "sleep";
};

&usbd {
	status = "okay";
};

/*
 * Flash layout (1 MB). No bootloader yet: the application starts at 0.
 * With MCUboot, code_partition is split into the bootloader (48 KB) and the
 * application slot.
 */
&flash0 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		code_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "app";
			reg = <0x00000000 0x00088000>;
		};

		/* Predictive text language models (read-only, updated separately). */
		lm_partition: partition@88000 {
			compatible = "zephyr,mapped-partition";
			label = "lm";
			reg = <0x00088000 0x00058000>;
		};

		/* Settings. */
		storage_partition: partition@e0000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x000e0000 0x00008000>;
		};

		/* LittleFS: messages, node database, user dictionary. */
		lfs_partition: partition@e8000 {
			compatible = "zephyr,mapped-partition";
			label = "lfs";
			reg = <0x000e8000 0x00018000>;
		};
	};
};
