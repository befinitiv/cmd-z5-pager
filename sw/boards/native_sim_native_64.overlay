/*
 * Emulator: the same node labels as the board (lcd, backlight, vibration,
 * speaker, earpiece), backed by the SDL front panel in emul/.
 */

/* Zephyr's own SDL display and touch input are not used. */
&sdl_dc {
	status = "disabled";
};

&input_sdl_touch {
	status = "disabled";
};

/* The same lfs partition size as on the board, in place of an unused one. */
/delete-node/ &scratch_partition;

&flash0 {
	partitions {
		lfs_partition: partition@de000 {
			label = "lfs";
			reg = <0x000de000 0x00018000>;
		};
	};
};

/ {
	frontpanel: frontpanel {
		compatible = "cmdz5,frontpanel";
		scale = <5>;
	};

	lcd_bus: lcd-bus {
		compatible = "cmdz5,lcd-bus-emul";

		lcd: lcd {
			compatible = "sony,cmdz5-lcd";
		};
	};

	emul-outputs {
		compatible = "cmdz5,led-emul";

		backlight: backlight {
			role = "backlight";
		};

		vibration: vibration {
			role = "vibration";
		};
	};

	speaker: speaker {
		compatible = "cmdz5,audio-emul";
		sink = "speaker";
	};

	earpiece: earpiece {
		compatible = "cmdz5,audio-emul";
		sink = "earpiece";
	};

	mesh_radio: mesh-radio {
		compatible = "cmdz5,radio-emul";
	};

	/* Messages (and later more): LittleFS in the lfs partition. */
	fstab {
		compatible = "zephyr,fstab";

		lfs: lfs {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&lfs_partition>;
			automount;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};
