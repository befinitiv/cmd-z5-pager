# Drivers for the CMD-Z5 hardware

config CMDZ5_LCD
	bool "CMD-Z5 display controller driver"
	default y
	depends on DT_HAS_SONY_CMDZ5_LCD_ENABLED

config CMDZ5_LCD_INIT_PRIORITY
	int "Display driver init priority"
	default 90
	help
	  Must be after the regulator that supplies the display.
	depends on CMDZ5_LCD

config CMDZ5_LCD_BUS_GPIO
	bool "Display bus bit-banged on GPIOs"
	default y
	depends on DT_HAS_CMDZ5_LCD_BUS_GPIO_ENABLED
	select GPIO

config CMDZ5_LCD_BUS_WR_LOW_NOPS
	int "Extra NOPs while /WR is low"
	default 16
	depends on CMDZ5_LCD_BUS_GPIO
	help
	  Stretches the /WR low phase. The original phone uses 300-350 ns.

config CMDZ5_LCD_BUS_INIT_PRIORITY
	int "Display bus init priority"
	default 80

module = CMDZ5_LCD
module-str = CMD-Z5 display
source "subsys/logging/Kconfig.template.log_config"

config CMDZ5_AUDIO_PWM
	bool "PCM output on an nRF PWM instance with EasyDMA"
	default y
	depends on DT_HAS_CMDZ5_AUDIO_PWM_ENABLED
	select NRFX_PWM
	select PINCTRL

config CMDZ5_AUDIO_INIT_PRIORITY
	int "Audio output init priority"
	default 90
	help
	  Must be after the regulator that supplies the earpiece amplifier.

module = CMDZ5_AUDIO
module-str = CMD-Z5 audio
source "subsys/logging/Kconfig.template.log_config"

config CMDZ5_SX1262
	bool "SX1262 mesh radio driver"
	default y
	depends on DT_HAS_CMDZ5_SX1262_ENABLED
	select SPI
	select GPIO
	select REGULATOR

config CMDZ5_SX1262_INIT_PRIORITY
	int "SX1262 driver init priority"
	default 90
	depends on CMDZ5_SX1262
	help
	  Must be after SPI, GPIO and the regulator that supplies the radio.

config CMDZ5_SX1262_THREAD_STACK_SIZE
	int "SX1262 interrupt thread stack size"
	default 2048
	depends on CMDZ5_SX1262

module = CMDZ5_RADIO
module-str = CMD-Z5 radio
source "subsys/logging/Kconfig.template.log_config"

config CMDZ5_GPS_M10
	bool "u-blox M10 GPS receiver with a switched supply"
	default y
	depends on DT_HAS_CMDZ5_GPS_M10_ENABLED
	depends on GNSS
	depends on GNSS_REFERENCE_FRAME_WGS84
	select GPIO
	select SERIAL
	select UART_INTERRUPT_DRIVEN
	select PM_DEVICE
	select MODEM_MODULES
	select MODEM_BACKEND_UART
	select MODEM_CHAT
	select GNSS_PARSE
	select GNSS_NMEA0183
	select GNSS_NMEA0183_MATCH

config CMDZ5_GPS_M10_SATELLITES_COUNT
	int "Maximum number of satellites reported"
	default 24
	depends on CMDZ5_GPS_M10 && GNSS_SATELLITES
