		(uuid "3c6f8cb1-864d-44a5-9777-bcb8f2695451")
	)
	(text "Pin 9 -> GND, pin 14 (/CS) -> GND,\npin 15 (CS) -> +3V0_LCD.\nWhen +3V0_LCD is off, drive all\nLCD_* lines low (no back-powering)."
		(exclude_from_sim no)
		(at 80 60 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "46102ff2-ab4b-4716-bea5-851a4c6668bb")
	)
	(text "PWM -> RC low-pass -> AC coupling. Amplifier is\npowered from nPM1300 LSOUT2 (VAMP), SD tied to VAMP.\nDrive EAR_PWM low while VAMP is off."
