	(text "Lid / encoder pull-ups: 10M so a closed contact\ncosts only 0.3 uA (disable the internal pull-ups\nin sleep). Pins 13/14 = LED + loudspeaker common."
		(exclude_from_sim no)
		(at 285 33 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2056d338-4260-43f2-9fc6-5a56c6755da0")
	)
	(text "Power key (flex pin 10, other side GND):\nwakes the nPM1300 from ship mode (SHPHLD,\n50k pull-up to VBAT) and is read by the nRF."
		(exclude_from_sim no)
		(at 285 70 0)
		(effects
